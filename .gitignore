# env files (NEVER commit — contains Neon DB password and API keys)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.vscode/
.idea/
*.swp
*.swo

# local Claude Code agent state (per-project, never commit)
.claude/
config.bat
